# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# Supabase connection string — Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-random-32+-char-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32+-char-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Must exactly match where the frontend runs — used for CORS
FRONTEND_URL="http://localhost:3000"

# --- Added in later phases — safe to leave blank for Phase 1 ---

# Supabase Storage (Phase 2)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram Bot (Phase 7)
TELEGRAM_BOT_TOKEN=""

# Transactional email — Resend or Brevo (Phase 7)
RESEND_API_KEY=""

# Gmail SMTP — local dev fallback only, never production (Master Plan Section 4C)
EMAIL_USER=""
EMAIL_PASSWORD=""

# Web Push VAPID keys (Phase 7) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
